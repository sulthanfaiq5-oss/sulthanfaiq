      let pendingCount = 0;

      STATE.transactions.forEach(t => {
        if (t.status === 'approved') {
          if (t.type === 'pemasukan') {
            incomeSum += t.amount;
            incomeCount++;
          } else {
            expenseSum += t.amount;
            expenseCount++;
          }
        } else {
          pendingCount++;
        }
      });

      const realBalance = incomeSum - expenseSum;

      // 2. Update Client Metrics
      document.getElementById('client-stat-balance').innerText = formatIDR(realBalance);
      document.getElementById('client-stat-income').innerText = formatIDR(incomeSum);
      document.getElementById('client-stat-income-count').innerText = `${incomeCount} Penerimaan Dana Sah`;
      document.getElementById('client-stat-expense').innerText = formatIDR(expenseSum);
      document.getElementById('client-stat-expense-count').innerText = `${expenseCount} Transaksi Belanja Sah`;
      document.getElementById('client-stat-pending-notes').innerText = `${pendingCount} Nota Menunggu Audit DOKU`;

      if (STATE.isPeriodLocked) {
        document.getElementById('client-stat-period-status').innerText = 'Buku Ditutup (Locked)';
        document.getElementById('client-stat-period-status').className = 'text-sm font-bold text-emerald-700 mt-1';
      } else {
        document.getElementById('client-stat-period-status').innerText = 'Buku Terbuka (Audit Berjalan)';
        document.getElementById('client-stat-period-status').className = 'text-sm font-bold text-blue-900 mt-1';
      }

      // Update Header Badges
      document.getElementById('queue-badge-pill').innerText = pendingCount;
      document.getElementById('admin-queue-tag').innerText = `${pendingCount} Nota Perlu Tindakan`;
      document.getElementById('admin-stat-pending-count').innerText = `${pendingCount} Nota`;
      document.getElementById('admin-stat-approved-count').innerText = `${incomeCount + expenseCount} Jurnal`;
      document.getElementById('admin-stat-balance-gl').innerText = formatIDR(realBalance);

      // Render Client Transactions Table
      renderClientTable();

      // Render Admin Queue (Meja Kerja)
      renderAdminQueue();

      // Render Admin General Ledger
      renderAdminGeneralLedger();

      // Update Report Modal Data
      updateReportModalData(incomeSum, incomeCount, expenseSum, expenseCount, realBalance);
    }

    /**
     * RENDER CLIENT TABLE
     */
    function renderClientTable() {
      const tbody = document.getElementById('client-tx-tbody');
      const filter = document.getElementById('client-filter-status').value;
      const formatIDR = (n) => 'Rp ' + Number(n).toLocaleString('id-ID');

      const filtered = STATE.transactions.filter(t => {
        if (filter === 'approved') return t.status === 'approved';
        if (filter === 'pending') return t.status === 'pending';
        return true;
      });

      tbody.innerHTML = '';

      if (filtered.length === 0) {
        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="text-center py-6 text-slate-400">Tidak ada transaksi yang cocok dengan filter.</td>
          </tr>
        `;
        return;
      }

      filtered.forEach(t => {
        const isApproved = t.status === 'approved';
        const isIncome = t.type === 'pemasukan';
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 transition';

        tr.innerHTML = `
          <td class="py-3 px-4 font-mono font-bold text-[11px] text-slate-700">${t.id}</td>
          <td class="py-3 px-4 text-slate-500 font-mono text-[11px]">${t.date}</td>
          <td class="py-3 px-4 font-semibold text-slate-900">
            ${t.desc}
            <div class="text-[10px] text-slate-400 font-normal mt-0.5">Metode: ${t.method} • ${t.auditorNote}</div>
          </td>
          <td class="py-3 px-4">
            <span class="px-2 py-0.5 rounded bg-slate-100 text-slate-600 font-medium text-[11px]">${t.category}</span>
          </td>
          <td class="py-3 px-4">
            <button onclick="previewReceipt('${t.receiptName}', '${t.desc}', '${t.amount}')" class="text-blue-700 hover:text-blue-900 underline flex items-center gap-1 font-semibold text-[11px]">
              <i data-lucide="paperclip" class="w-3 h-3"></i>
              <span>${t.receiptName}</span>
            </button>
          </td>
          <td class="py-3 px-4 text-right font-mono font-bold ${isIncome ? 'text-emerald-600' : 'text-slate-900'}">
            ${isIncome ? '+' : '-'} ${formatIDR(t.amount)}
          </td>
          <td class="py-3 px-4 text-center">
            ${isApproved 
              ? '<span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-800 font-bold px-2.5 py-0.5 rounded-full text-[10px]"><i data-lucide="check-circle" class="w-3 h-3"></i> Tervalidasi</span>' 
              : '<span class="inline-flex items-center gap-1 bg-amber-100 text-amber-800 font-bold px-2.5 py-0.5 rounded-full text-[10px]"><i data-lucide="clock" class="w-3 h-3"></i> Diaudit DOKU</span>'}
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    function filterClientTable() {
      renderClientTable();
      lucide.createIcons();
    }

    /**
     * RENDER ADMIN VERIFICATION QUEUE (MEJA AUDITOR)
     */
    function renderAdminQueue() {
      const container = document.getElementById('admin-queue-list');
      const formatIDR = (n) => 'Rp ' + Number(n).toLocaleString('id-ID');
      const pendings = STATE.transactions.filter(t => t.status === 'pending');

      container.innerHTML = '';

      if (pendings.length === 0) {
        container.innerHTML = `
          <div class="p-6 text-center text-slate-400 border border-dashed rounded-xl bg-slate-50 space-y-1">
            <i data-lucide="check-check" class="w-8 h-8 text-emerald-500 mx-auto mb-1"></i>
            <p class="text-xs font-bold text-slate-800">Semua nota dan setoran belanja telah diaudit!</p>
            <p class="text-[11px]">Buku kas dan rekening koran klien saat ini berada dalam kondisi seimbang (Reconciled).</p>
          </div>
        `;
        return;
      }

      pendings.forEach(t => {
        const card = document.createElement('div');
        card.className = 'p-4 rounded-xl border border-amber-200 bg-amber-50/50 space-y-3';
        card.innerHTML = `
          <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 pb-3 border-b border-amber-200/70">
            <div class="space-y-0.5">
              <div class="flex items-center gap-2">
                <span class="font-mono text-[10px] bg-slate-800 text-white px-2 py-0.5 rounded font-bold">${t.id}</span>
                <span class="text-xs font-bold text-slate-900">${t.desc}</span>
                <span class="text-[10px] text-slate-500 font-mono">• ${t.date}</span>
              </div>
              <p class="text-xs text-slate-600">Disetor via ${t.method} • Kategori Usulan: <strong>${t.category}</strong></p>
            </div>
            <div class="text-right">
              <span class="text-xs text-slate-400 font-medium block">Nominal Tertera:</span>
              <span class="text-base font-black font-mono text-rose-700">${formatIDR(t.amount)}</span>
            </div>
          </div>

          <!-- Auditor Controls -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs items-center">
            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Verifikasi Bukti Kuitansi Fisik:</label>
              <button onclick="previewReceipt('${t.receiptName}', '${t.desc}', '${t.amount}')" class="px-3 py-1.5 bg-white border border-slate-300 hover:bg-slate-50 rounded-lg text-slate-800 font-semibold flex items-center gap-1.5 w-full">
                <i data-lucide="eye" class="w-3.5 h-3.5 text-blue-600"></i>
                <span class="truncate">Tinjau ${t.receiptName}</span>
              </button>
            </div>

            <div>
              <label class="block text-[11px] font-bold text-slate-700 mb-1">Tetapkan Kode COA Akuntansi:</label>
              <select id="coa-select-${t.id}" class="w-full bg-white border border-slate-300 rounded-lg p-1.5 text-slate-800 font-medium">
                <option value="5-102 (Beban Konsumsi)">5-102 (Beban Konsumsi)</option>
                <option value="5-101 (Beban ATK & Kantor)">5-101 (Beban ATK & Kantor)</option>
                <option value="5-201 (Beban Sewa & Properti)">5-201 (Beban Sewa & Properti)</option>
                <option value="5-301 (Beban Honorarium)">5-301 (Beban Honorarium)</option>
              </select>
            </div>

            <div class="flex items-center gap-2 pt-4 md:pt-0">
              <button onclick="approveTransactionByAuditor('${t.id}')" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-3 rounded-xl transition flex items-center justify-center gap-1.5 shadow-sm">
                <i data-lucide="check" class="w-3.5 h-3.5"></i>
                <span>Sahkan Jurnal</span>
              </button>
              <button onclick="rejectTransactionByAuditor('${t.id}')" class="px-3 py-2 border border-slate-300 hover:bg-white text-rose-700 font-bold rounded-xl transition">
                Tolak Nota
              </button>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    }

    /**
     * RENDER GENERAL LEDGER (JURNAL UMUM)
     */
    function renderAdminGeneralLedger() {
      const tbody = document.getElementById('admin-gl-tbody');
      const formatIDR = (n) => 'Rp ' + Number(n).toLocaleString('id-ID');
      const approveds = STATE.transactions.filter(t => t.status === 'approved');

      tbody.innerHTML = '';

      approveds.forEach(t => {
        const isIncome = t.type === 'pemasukan';
        const tr = document.createElement('tr');
        tr.className = 'hover:bg-slate-50 transition';

        tr.innerHTML = `
          <td class="py-3 px-4 font-bold text-slate-800">${t.id}</td>
          <td class="py-3 px-4 text-slate-500">${t.date}</td>
          <td class="py-3 px-4 font-sans">
            <strong class="text-slate-900 block">${t.desc}</strong>
            <span class="text-[10px] text-slate-400 font-mono">Diverifikasi oleh: ${t.verifiedBy}</span>
          </td>
          <td class="py-3 px-4 text-slate-600">${t.coaCode}</td>
          <td class="py-3 px-4 text-right font-bold text-emerald-600">${isIncome ? formatIDR(t.amount) : '-'}</td>
          <td class="py-3 px-4 text-right font-bold text-rose-600">${!isIncome ? formatIDR(t.amount) : '-'}</td>
          <td class="py-3 px-4 text-center font-sans">
            <span class="inline-flex items-center gap-1 text-[10px] text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full font-semibold">
              <i data-lucide="lock" class="w-2.5 h-2.5"></i> Sah
            </span>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }

    /**
     * CLIENT FORM SUBMISSION (SETOR NOTA)
     */
    function handleClientSetorNota(e) {
      e.preventDefault();

      if (STATE.isPeriodLocked) {
        showToast('Periode buku kas telah ditutup oleh akuntan! Tidak dapat menyetor transaksi bulan lalu.', 'error');
        return;
      }

      const type = document.querySelector('input[name="input_type"]:checked').value;
      const desc = document.getElementById('input_desc').value.trim();
      const date = document.getElementById('input_date').value;
      const amount = parseFloat(document.getElementById('input_amount').value);
      const method = document.getElementById('input_method').value;
      const category = document.getElementById('input_category').value;
      const fileInput = document.getElementById('input_receipt_file');

      const fileName = fileInput.files.length > 0 
        ? fileInput.files[0].name 
        : `struk-nota-${Math.floor(100 + Math.random() * 900)}.jpg`;

      const newTx = {
        id: "TX-2026-" + String(STATE.transactions.length + 1).padStart(3, '0'),
        date: date,
        desc: desc,
        type: type,
        category: category,
        method: method,
        amount: amount,
        receiptName: fileName,
        status: "pending",
        coaCode: "5-999 (Menunggu Klasifikasi)",
        auditorNote: "Baru disetor klien, menunggu verifikasi staf DOKU.",
        verifiedBy: "-",
      };

      STATE.transactions.unshift(newTx);
      closeModal('modal-setor-nota');
      document.getElementById('form-setor-nota').reset();
      
      showToast(`Nota "${desc}" berhasil disetor! Menunggu verifikasi tim Akuntan DOKU.`, 'success');
      renderAll();
      lucide.createIcons();
    }

    /**
     * AUDITOR ACTIONS
     */
    function approveTransactionByAuditor(id) {
      const tx = STATE.transactions.find(t => t.id === id);
      if (!tx) return;

      const coaSelect = document.getElementById(`coa-select-${id}`);
      if (coaSelect) {
        tx.coaCode = coaSelect.value;
      }

      tx.status = 'approved';
      tx.auditorNote = 'Diverifikasi sah fisik kuitansi & masuk buku kas.';
      tx.verifiedBy = 'Rian Pratama, CA';

      showToast(`Transaksi ${id} disahkan! Jurnal umum dan saldo kas resmi telah diperbarui.`, 'success');
      renderAll();
      lucide.createIcons();
    }

    function rejectTransactionByAuditor(id) {
      const tx = STATE.transactions.find(t => t.id === id);
      if (!tx) return;

      STATE.transactions = STATE.transactions.filter(t => t.id !== id);
      showToast(`Nota ${id} ditolak karena rincian tidak terbaca / tidak memenuhi standar bukti sah.`, 'error');
      renderAll();
      lucide.createIcons();
    }

    function toggleLockPeriod() {
      STATE.isPeriodLocked = !STATE.isPeriodLocked;
      const btn = document.getElementById('btn-lock-period');
      const label = document.getElementById('label-lock-period');

      if (STATE.isPeriodLocked) {
        btn.className = 'bg-rose-900/60 hover:bg-rose-800 text-rose-200 border border-rose-700 text-xs font-semibold px-3 py-1.5 rounded-xl transition flex items-center gap-1.5';
        label.innerText = 'Buka Kunci Periode';
        showToast('Periode buku kas resmi dikunci (Tutup Buku). Laporan keuangan final terbit.', 'warning');
      } else {
        btn.className = 'bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-semibold px-3 py-1.5 rounded-xl transition flex items-center gap-1.5';
        label.innerText = 'Kunci Periode (Tutup Buku)';
        showToast('Kunci periode dibuka kembali untuk entri koreksi jurnal.', 'info');
      }

      renderAll();
      lucide.createIcons();
    }

    /**
     * RECEIPT PREVIEW SIMULATOR
     */
    function previewReceipt(name, desc, amount) {
      const formatIDR = (n) => 'Rp ' + Number(n).toLocaleString('id-ID');
      
      const modal = document.createElement('div');
      modal.className = 'fixed inset-0 z-50 bg-slate-950/70 backdrop-blur-xs flex items-center justify-center p-4';
      modal.innerHTML = `
        <div class="bg-white rounded-2xl max-w-sm w-full overflow-hidden shadow-2xl border border-slate-200 text-xs">
          <div class="p-4 bg-slate-900 text-white flex justify-between items-center">
            <span class="font-bold flex items-center gap-1.5">
              <i data-lucide="image" class="w-4 h-4 text-blue-400"></i> Pratinjau Bukti Fisik
            </span>
            <button onclick="this.closest('.fixed').remove()" class="text-slate-400 hover:text-white">&times;</button>
          </div>
          <div class="p-6 text-center space-y-3">
            <div class="p-6 bg-slate-50 border-2 border-dashed border-slate-300 rounded-xl relative">
              <i data-lucide="receipt-text" class="w-12 h-12 text-slate-400 mx-auto mb-2"></i>
              <strong class="text-slate-800 block">${name}</strong>
              <p class="text-slate-500 text-[11px] mt-1">${desc}</p>
              <p class="font-mono font-bold text-rose-700 text-sm mt-2">${formatIDR(amount)}</p>
              <div class="mt-3 inline-block px-2 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded">
                TERVERIFIKASI FISIK DOKU
              </div>
            </div>
            <p class="text-[11px] text-slate-400">Berkas tersimpan aman di Private Storage Vault DOKU.</p>
          </div>
          <div class="p-3 bg-slate-100 text-right">
            <button onclick="this.closest('.fixed').remove()" class="px-4 py-1.5 bg-slate-900 text-white rounded-lg font-bold">Tutup</button>
          </div>
        </div>
      `;
      document.body.appendChild(modal);
      lucide.createIcons();
    }

    /**
     * BANK STATEMENT RECONCILIATION SIMULATOR
     */
    function simulateBankSync() {
      closeModal('modal-reconcile');
      showToast('Sinkronisasi rekening koran berhasil! Saldo giro bank cocok 100% dengan buku kas DOKU.', 'success');
      renderAll();
    }

    /**
     * UPDATE REPORT MODAL DATA
     */
    function updateReportModalData(incomeSum, incomeCount, expenseSum, expenseCount, realBalance) {
      const formatIDR = (n) => 'Rp ' + Number(n).toLocaleString('id-ID');

      document.getElementById('rep-income-count').innerText = `${incomeCount} Transaksi Masuk`;
      document.getElementById('rep-income-total').innerText = formatIDR(incomeSum);

      document.getElementById('rep-expense-count').innerText = `${expenseCount} Belanja Sah`;
      document.getElementById('rep-expense-total').innerText = `- ${formatIDR(expenseSum)}`;

      document.getElementById('rep-balance-final').innerText = formatIDR(realBalance);

      // Breakdown per category
      const catMap = {};
      STATE.transactions.filter(t => t.status === 'approved' && t.type === 'pengeluaran').forEach(t => {
        catMap[t.category] = (catMap[t.category] || 0) + t.amount;
      });

      const catTbody = document.getElementById('rep-category-breakdown');
      catTbody.innerHTML = '';

      for (const [cat, val] of Object.entries(catMap)) {
        const pct = expenseSum > 0 ? ((val / expenseSum) * 100).toFixed(1) : 0;
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td class="p-2.5 font-bold text-slate-800">${cat}</td>
          <td class="p-2.5">
            <div class="flex items-center gap-2">
              <div class="w-24 bg-slate-200 h-2 rounded-full overflow-hidden">
                <div class="bg-blue-600 h-full rounded-full" style="width: ${pct}%"></div>
              </div>
              <span class="font-mono text-slate-500">${pct}%</span>
            </div>
          </td>
          <td class="p-2.5 text-right font-mono font-bold text-slate-900">${formatIDR(val)}</td>
        `;
        catTbody.appendChild(tr);
      }
    }

    /**
     * MODAL HELPERS
     */
    function openSetorNotaModal() {
      document.getElementById('modal-setor-nota').classList.remove('hidden');
      document.getElementById('modal-setor-nota').classList.add('flex');
    }

    function openReconcileModal() {
      document.getElementById('modal-reconcile').classList.remove('hidden');
      document.getElementById('modal-reconcile').classList.add('flex');
    }

    function openReportModal() {
      document.getElementById('modal-report').classList.remove('hidden');
      document.getElementById('modal-report').classList.add('flex');
    }

    function closeModal(id) {
      document.getElementById(id).classList.add('hidden');
      document.getElementById(id).classList.remove('flex');
    }

    /**
     * TOAST HELPER
     */
    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');

      const colors = {
        success: 'bg-emerald-600 text-white',
        error: 'bg-rose-600 text-white',
        info: 'bg-slate-900 text-white border border-slate-800',
        warning: 'bg-amber-600 text-white'
      };

      toast.className = `p-3.5 rounded-xl shadow-xl flex items-center gap-2 text-xs font-medium transition-all duration-300 transform translate-y-2 opacity-0 pointer-events-auto ${colors[type] || colors.info}`;
      toast.innerHTML = `
        <span class="flex-1">${message}</span>
        <button onclick="this.parentElement.remove()" class="opacity-70 hover:opacity-100">&times;</button>
      `;

      container.appendChild(toast);
      setTimeout(() => toast.classList.remove('translate-y-2', 'opacity-0'), 10);
      setTimeout(() => {
        toast.classList.add('opacity-0', 'translate-x-4');
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }
  </script>
</body>

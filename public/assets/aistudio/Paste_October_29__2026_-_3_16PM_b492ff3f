<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DOKU Financial - Jasa Pencatatan & Pengelolaan Keuangan</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            brand: {
              50: '#f0f5fa',
              100: '#e1ecf5',
              800: '#172554',
              900: '#0f172a',
              950: '#090d16',
            }
          }
        }
      }
    }
  </script>
  <style>
    @media print {
      body * { visibility: hidden; }
      #printable-report-modal, #printable-report-modal * { visibility: visible; }
      #printable-report-modal {
        position: absolute; left: 0; top: 0; width: 100%; margin: 0; padding: 24px; background: white;
      }
      .no-print { display: none !important; }
    }
    .custom-scroll::-webkit-scrollbar { width: 6px; height: 6px; }
    .custom-scroll::-webkit-scrollbar-track { background: #f1f5f9; }
    .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased font-sans flex flex-col min-h-screen">

  <!-- ============================================================== -->
  <!-- 0. PERSISTENT POV SWITCHER BAR (SIMULATOR HEADER) -->
  <!-- ============================================================== -->
  <aside class="sticky top-0 z-50 bg-brand-950 border-b border-slate-800 text-white px-4 py-2.5 shadow-md no-print">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="flex h-2.5 w-2.5 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
        </span>
        <div class="text-xs">
          <span class="text-slate-400">Mode Simulasi Peran:</span>
          <strong id="active-pov-label" class="text-blue-400 font-bold ml-1 uppercase">POV Klien (Pelanggan / Bendahara Organisasi)</strong>
        </div>
        <span class="text-[11px] bg-slate-800 text-slate-300 px-2 py-0.5 rounded border border-slate-700 hidden md:inline font-mono">Shared Accounting Engine Active</span>
      </div>

      <!-- Quick Switcher Buttons -->
      <div class="flex items-center gap-2 bg-slate-900 p-1 rounded-xl border border-slate-800 text-xs">
        <button id="btn-pov-client" onclick="switchPOV('client')" class="flex items-center gap-2 px-3 py-1.5 rounded-lg font-bold transition duration-200 bg-blue-600 text-white shadow-sm">
          <i data-lucide="building-2" class="w-3.5 h-3.5"></i>
          <span>POV Klien (Organisasi/UMKM)</span>
        </button>
        <button id="btn-pov-admin" onclick="switchPOV('admin')" class="flex items-center gap-2 px-3 py-1.5 rounded-lg font-medium transition duration-200 text-slate-400 hover:text-white">
          <i data-lucide="calculator" class="w-3.5 h-3.5"></i>
          <span>POV Akuntan / Auditor DOKU</span>
          <span id="queue-badge-pill" class="bg-amber-500 text-slate-950 text-[10px] font-black px-1.5 py-0.2 rounded-full">1</span>
        </button>
      </div>
    </div>
  </aside>

  <!-- Flash Notification Toast Container -->
  <div id="toast-container" class="fixed top-16 right-4 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"></div>

  <!-- ============================================================== -->
  <!-- 1. VIEWPORT: CLIENT / CUSTOMER BOOKKEEPING PORTAL -->
  <!-- ============================================================== -->
  <div id="view-client" class="flex-1 flex flex-col">
    <!-- Client Top Nav -->
    <header class="bg-white border-b border-slate-200 sticky top-12 z-30 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-900 to-indigo-800 text-white flex items-center justify-center font-bold text-lg shadow-sm">
            D
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-extrabold text-slate-900 text-base">DOKU Financial</span>
              <span class="text-xs bg-blue-50 text-blue-700 font-bold px-2 py-0.5 rounded-full border border-blue-200">Portal Klien</span>
            </div>
            <p class="text-[11px] text-slate-500">Klien Aktif: <strong class="text-slate-800">BEM Universitas Indonesia Merdeka</strong> • Paket Jasa: Standard Monthly Bookkeeping</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <button onclick="openSetorNotaModal()" class="bg-blue-900 hover:bg-blue-800 text-white text-xs font-bold px-3.5 py-2 rounded-xl transition flex items-center gap-1.5 shadow-sm">
            <i data-lucide="receipt" class="w-4 h-4"></i>
            <span>Setor Nota / Struk Baru</span>
          </button>
          <button onclick="openReconcileModal()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold px-3 py-2 rounded-xl border border-slate-200 transition flex items-center gap-1.5 hidden sm:flex">
            <i data-lucide="file-spreadsheet" class="w-4 h-4 text-emerald-600"></i>
            <span>Sinkron Mutasi Bank</span>
          </button>
          <div class="h-6 w-px bg-slate-200 hidden sm:block"></div>
          <div class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-full bg-slate-100 border border-slate-300 text-slate-700 flex items-center justify-center font-bold text-xs">
              BM
            </div>
            <div class="hidden md:block text-left text-xs">
              <p class="font-bold text-slate-900 leading-tight">M. Ihsan (Bendahara)</p>
              <p class="text-[11px] text-slate-500">Panitia Dies Natalis 2026</p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Client Content Body -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 w-full space-y-6 flex-1">
      
      <!-- Informative Greeting Banner -->
      <div class="rounded-2xl p-4 bg-gradient-to-r from-blue-950 via-slate-900 to-indigo-950 text-white flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-sm">
        <div class="flex items-center gap-3">
          <div class="p-2.5 rounded-xl bg-blue-800/60 border border-blue-700 shrink-0">
            <i data-lucide="shield-check" class="w-5 h-5 text-emerald-400"></i>
          </div>
          <div>
            <h3 class="text-sm font-bold">Layanan Pengelolaan Keuangan & Akuntansi DOKU Aktif</h3>
            <p class="text-xs text-blue-200 mt-0.5">Seluruh nota belanja Anda diaudit, dijurnal, dan dicocokkan dengan mutasi bank oleh tim akuntan profesional.</p>
          </div>
        </div>
        <div class="flex items-center gap-2 w-full md:w-auto">
          <button onclick="openReportModal()" class="flex-1 md:flex-initial bg-emerald-500 hover:bg-emerald-600 text-white text-xs font-bold px-3.5 py-2 rounded-xl transition flex items-center justify-center gap-1.5 shadow-sm">
            <i data-lucide="file-text" class="w-3.5 h-3.5"></i>
            <span>Lihat Laporan LPJ Sah</span>
          </button>
        </div>
      </div>

      <!-- Financial Metrics Cards (Client Saldo Real) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Kas Riil Tervalidasi -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-medium text-slate-500">Saldo Kas Riil Sah</span>
            <h3 id="client-stat-balance" class="text-xl font-black text-slate-900 font-mono mt-1">Rp 16.750.000</h3>
            <span class="text-[11px] text-emerald-600 font-semibold flex items-center gap-1 mt-0.5">
              <i data-lucide="check" class="w-3 h-3"></i> Tervalidasi Auditor DOKU
            </span>
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <i data-lucide="landmark" class="w-5 h-5"></i>
          </div>
        </div>

        <!-- Total Pemasukan -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-medium text-slate-500">Pemasukan Disahkan</span>
            <h3 id="client-stat-income" class="text-xl font-black text-emerald-600 font-mono mt-1">Rp 22.500.000</h3>
            <span id="client-stat-income-count" class="text-[11px] text-slate-500 mt-0.5 block">2 Penerimaan Dana Sah</span>
          </div>
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
            <i data-lucide="arrow-down-left" class="w-5 h-5"></i>
          </div>
        </div>

        <!-- Total Pengeluaran Sah -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-medium text-slate-500">Pengeluaran Disahkan</span>
            <h3 id="client-stat-expense" class="text-xl font-black text-rose-600 font-mono mt-1">Rp 5.750.000</h3>
            <span id="client-stat-expense-count" class="text-[11px] text-slate-500 mt-0.5 block">4 Transaksi Belanja Sah</span>
          </div>
          <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
            <i data-lucide="arrow-up-right" class="w-5 h-5"></i>
          </div>
        </div>

        <!-- Status Tutup Buku Periode -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-medium text-slate-500">Status Buku Kas Periode</span>
            <h3 id="client-stat-period-status" class="text-sm font-bold text-blue-900 mt-1">Buku Terbuka (Audit Berjalan)</h3>
            <span id="client-stat-pending-notes" class="text-[11px] text-amber-600 font-medium mt-0.5 block">1 Nota Menunggu Audit</span>
          </div>
          <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
            <i data-lucide="book-open-check" class="w-5 h-5"></i>
          </div>
        </div>
      </div>

      <!-- Accounting Workflow Stepper for Client -->
      <div class="bg-white rounded-2xl border border-slate-200 p-5 sm:p-6 shadow-sm">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 flex items-center gap-2">
          <i data-lucide="route" class="w-4 h-4 text-blue-600"></i>
          <span>Alur Transparansi Jasa Pembukuan Organisasi Anda</span>
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3 text-xs">
          <div class="p-3.5 rounded-xl bg-blue-50/70 border border-blue-200">
            <div class="flex items-center gap-2 mb-1">
              <span class="w-5 h-5 rounded-full bg-blue-900 text-white font-bold text-[10px] flex items-center justify-center">1</span>
              <strong class="text-blue-950">Setor Nota & Struk</strong>
            </div>
            <p class="text-[11px] text-blue-800">Unggah foto struk belanja panitia dan mutasi transfer bank secara praktis.</p>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="flex items-center gap-2 mb-1">
              <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-700 font-bold text-[10px] flex items-center justify-center">2</span>
              <strong class="text-slate-800">Pemeriksaan Auditor</strong>
            </div>
            <p class="text-[11px] text-slate-600">Akuntan DOKU menguji keaslian nota, pos akun beban, dan mencegah belanja duplikat.</p>
          </div>
          <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
            <div class="flex items-center gap-2 mb-1">
              <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-700 font-bold text-[10px] flex items-center justify-center">3</span>
              <strong class="text-slate-800">Penjurnalan Kas Sah</strong>
            </div>
            <p class="text-[11px] text-slate-600">Saldo kas otomatis terbarui dan dicocokkan dengan buku besar akuntansi.</p>
          </div>
          <div class="p-3.5 rounded-xl bg-emerald-50/80 border border-emerald-200">
            <div class="flex items-center gap-2 mb-1">
              <span class="w-5 h-5 rounded-full bg-emerald-600 text-white font-bold text-[10px] flex items-center justify-center">4</span>
              <strong class="text-emerald-950">Terbit LPJ Sah (PDF)</strong>
            </div>
            <p class="text-[11px] text-emerald-800">Laporan pertanggungjawaban bertanda tangan digital siap dipertanggungjawabkan.</p>
          </div>
        </div>
      </div>

      <!-- Buku Kas Klien Table (Transactions) -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
          <div>
            <h3 class="font-bold text-slate-900 text-base">Buku Kas Transaksi Organisasi</h3>
            <p class="text-xs text-slate-500">Daftar transaksi yang disetor panitia dan status verifikasi dari tim akuntansi DOKU.</p>
          </div>
          <div class="flex items-center gap-2">
            <select id="client-filter-status" onchange="filterClientTable()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-1.5 text-xs font-semibold text-slate-700 focus:outline-none">
              <option value="all">Semua Status</option>
              <option value="approved">Hanya yang Sah (Tervalidasi)</option>
              <option value="pending">Menunggu Audit DOKU</option>
            </select>
            <button onclick="openReportModal()" class="px-3.5 py-1.5 bg-blue-900 hover:bg-blue-800 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5">
              <i data-lucide="printer" class="w-3.5 h-3.5"></i>
              <span>Cetak LPJ Kas</span>
            </button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-200">
              <tr>
                <th class="py-3 px-4">Kode Transaksi</th>
                <th class="py-3 px-4">Tanggal</th>
                <th class="py-3 px-4">Deskripsi Transaksi</th>
                <th class="py-3 px-4">Kategori Beban / Pendapatan</th>
                <th class="py-3 px-4">Bukti Nota Fisik</th>
                <th class="py-3 px-4 text-right">Nominal</th>
                <th class="py-3 px-4 text-center">Status Audit DOKU</th>
              </tr>
            </thead>
            <tbody id="client-tx-tbody" class="divide-y divide-slate-100 font-medium">
              <!-- Dynamically rendered -->
            </tbody>
          </table>
        </div>
      </div>

    </main>
  </div>

  <!-- ============================================================== -->
  <!-- 2. VIEWPORT: ACCOUNTANT & AUDITOR MEJA KERJA WORKSTATION -->
  <!-- ============================================================== -->
  <div id="view-admin" class="flex-1 flex flex-col hidden">
    <!-- Admin Top Nav -->
    <header class="bg-brand-950 text-white border-b border-slate-800 sticky top-12 z-30 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-emerald-500 text-slate-950 flex items-center justify-center font-black text-lg shadow-sm">
            <i data-lucide="briefcase" class="w-5 h-5"></i>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="font-extrabold text-white text-base">DOKU Workstation</span>
              <span class="text-xs bg-emerald-500/20 text-emerald-300 font-bold px-2 py-0.5 rounded-full border border-emerald-500/30">Meja Akuntan & Auditor</span>
            </div>
            <p class="text-[11px] text-slate-400">Auditor Utama: <strong class="text-slate-200">Rian Pratama, S.Ak., CA</strong> • Standar SAK EMKM / Akuntansi Nirlaba</p>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <button onclick="toggleLockPeriod()" id="btn-lock-period" class="bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-xs font-semibold px-3 py-1.5 rounded-xl transition flex items-center gap-1.5">
            <i data-lucide="lock" class="w-3.5 h-3.5 text-amber-400"></i>
            <span id="label-lock-period">Kunci Periode (Tutup Buku)</span>
          </button>
          <div class="h-6 w-px bg-slate-800 hidden sm:block"></div>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-emerald-600 text-slate-950 flex items-center justify-center font-black text-xs">
              RP
            </div>
            <span class="text-xs font-bold text-white hidden md:inline">Auditor Internal</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Admin Content Body -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 py-6 w-full space-y-6 flex-1">
      
      <!-- Metrics Overview for Accountant -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-medium text-slate-500">Antrean Nota Disetor Klien</span>
            <h3 id="admin-stat-pending-count" class="text-xl font-black text-amber-600 font-mono mt-1">1 Nota</h3>
            <span class="text-[11px] text-slate-500">Menunggu pemeriksaan fisik</span>
          </div>
          <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
            <i data-lucide="file-clock" class="w-5 h-5"></i>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-medium text-slate-500">Total Transaksi Sah Masuk Buku</span>
            <h3 id="admin-stat-approved-count" class="text-xl font-black text-slate-900 font-mono mt-1">6 Jurnal</h3>
            <span class="text-[11px] text-emerald-600 font-medium">Masuk Buku Besar</span>
          </div>
          <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
            <i data-lucide="book-marked" class="w-5 h-5"></i>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-medium text-slate-500">Saldo Akhir Buku Kas</span>
            <h3 id="admin-stat-balance-gl" class="text-xl font-black text-emerald-700 font-mono mt-1">Rp 16.750.000</h3>
            <span class="text-[11px] text-slate-500">Reconciled with Bank Statement</span>
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <i data-lucide="scale" class="w-5 h-5"></i>
          </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-medium text-slate-500">Billing Jasa Pembukuan</span>
            <h3 class="text-xl font-black text-slate-900 font-mono mt-1">Rp 750.000</h3>
            <span class="text-[11px] text-emerald-600 font-bold">Status: Terbayar (Paket Okt)</span>
          </div>
          <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
            <i data-lucide="badge-dollar-sign" class="w-5 h-5"></i>
          </div>
        </div>
      </div>

      <!-- Main Operational Queue (Queue Verification Meja Kerja) -->
      <div class="bg-white rounded-2xl border border-slate-200 p-5 sm:p-6 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-100">
          <div>
            <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="stamp" class="w-4 h-4 text-amber-500"></i>
              <span>Meja Kerja Auditor: Antrean Nota & Dokumen Belanja Masuk</span>
            </h3>
            <p class="text-xs text-slate-500">Periksa foto bukti kuitansi yang disetor panitia, tentukan akun beban yang sesuai, dan sahkan ke Buku Besar Kas.</p>
          </div>
          <span id="admin-queue-tag" class="text-xs font-mono font-bold px-3 py-1 rounded-full bg-amber-100 text-amber-800">
            1 Nota Perlu Tindakan
          </span>
        </div>

        <div id="admin-queue-list" class="space-y-4">
          <!-- Dynamically populated queue cards -->
        </div>
      </div>

      <!-- General Ledger / Jurnal Umum Akuntansi -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
          <div>
            <h3 class="font-bold text-slate-900 text-base">Jurnal Umum (General Ledger) Resmi</h3>
            <p class="text-xs text-slate-500">Setiap transaksi sah telah dipetakan ke akun debit-kredit dan terkunci dari pengubahan liar.</p>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="openReportModal()" class="px-3.5 py-1.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
              <i data-lucide="file-check-2" class="w-3.5 h-3.5 text-emerald-400"></i>
              <span>Cetak Laporan Keuangan Sah</span>
            </button>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-600 font-semibold border-b border-slate-200">
